/* Tema escuro do Semantorium (aplicado sobre a base clara). */

QMainWindow, QWidget {
    background:#161a20;
    color:#e6eaf0;
}

QTabWidget::pane {
    border:1px solid #2a313b;
    background:#1c222a;
}

QTabBar::tab {
    background:transparent;
    color:#9aa6b4;
}
QTabBar::tab:selected {
    color:#7fb2ff;
    border-bottom:2px solid #3d8bfd;
}
QTabBar::tab:disabled {
    color:#4a5563;
}

QPushButton {
    background:#232a33;
    border:1px solid #333c48;
    color:#e6eaf0;
}
QPushButton:hover {
    border-color:#3d8bfd;
    color:#a8c7ff;
}
QPushButton:disabled {
    color:#5a6572;
    border-color:#272e37;
}
QPushButton#Primary {
    background:#2d7ff9;
    border:none;
    color:#ffffff;
}
QPushButton#Primary:hover {
    background:#1c6be8;
}
QPushButton#Primary:disabled {
    background:#2a3a56;
    color:#8ea6cc;
}

QProgressBar {
    border:1px solid #333c48;
    background:#1c222a;
    color:#e6eaf0;
}
QProgressBar::chunk {
    background:#3d8bfd;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background:#1c222a;
    border:1px solid #333c48;
    color:#e6eaf0;
    selection-background-color:#2d7ff9;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color:#3d8bfd;
}
QComboBox QAbstractItemView {
    background:#1c222a;
    color:#e6eaf0;
    selection-background-color:#2d4a75;
}

QScrollArea {
    background:transparent;
}

QTextEdit, QTextBrowser {
    background:#1c222a;
    border:1px solid #2a313b;
    color:#e6eaf0;
}

QTableWidget, QTableView, QListWidget, QTreeWidget {
    background:#1c222a;
    alternate-background-color:#1f2630;
    border:1px solid #2a313b;
    color:#e6eaf0;
    gridline-color:#2a313b;
}
QHeaderView::section {
    background:#232a33;
    color:#c3ccd8;
    border:1px solid #2a313b;
    padding:4px;
}
QTableWidget::item:selected, QListWidget::item:selected {
    background:#2d4a75;
    color:#ffffff;
}

QMenuBar, QMenu {
    background:#1c222a;
    color:#e6eaf0;
}
QMenuBar::item:selected, QMenu::item:selected {
    background:#2d4a75;
}
QMenu::separator {
    background:#2a313b;
    height:1px;
}

QStatusBar {
    background:#1c222a;
    border-top:1px solid #2a313b;
    color:#9aa6b4;
}

QToolTip {
    background:#232a33;
    color:#e6eaf0;
    border:1px solid #3d8bfd;
}

QCheckBox, QRadioButton, QLabel {
    color:#e6eaf0;
}

QGroupBox {
    border:1px solid #2a313b;
    border-radius:8px;
    margin-top:10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left:10px;
    padding:0 4px;
    color:#a8c7ff;
}

QDialog {
    background:#161a20;
    color:#e6eaf0;
}

QSplitter::handle {
    background:#2a313b;
}

/* Widgets nomeados de ui/widgets/common.py */
QFrame#Card {
    background:#1c222a;
    border:1px solid #2a313b;
    border-radius:10px;
}
QFrame#Kpi {
    background:#1d2837;
    border:1px solid #2d4a75;
    border-radius:9px;
}
QLabel#KpiValue {
    color:#7fb2ff;
}
QLabel#KpiName {
    color:#9aa6b4;
}
QTableWidget#DataTable {
    background:#1c222a;
    alternate-background-color:#1f2630;
    border:1px solid #2a313b;
    border-radius:8px;
    gridline-color:#2a313b;
    color:#e6eaf0;
}
QTableWidget#DataTable QHeaderView::section {
    background:#232a33;
    border:none;
    border-bottom:1px solid #2a313b;
    padding:6px;
    font-weight:600;
    color:#c3ccd8;
    text-align:left;
}
QLabel#SectionHeader {
    color:#e6eaf0;
}
QLabel#Chip {
    background:#22303f;
    color:#a8c7ff;
    border-radius:11px;
    padding:4px 10px;
    font-size:11px;
}
QFrame#HLine {
    color:#2a313b;
}
QPushButton#TabGroup {
    background:transparent;
    border:none;
    border-radius:6px;
    padding:6px 10px;
    color:#9aa6b4;
    font-weight:600;
}
QPushButton#TabGroup:hover {
    background:#1d2837;
    color:#a8c7ff;
}
QPushButton#TabGroup:checked {
    background:#1d2837;
    color:#7fb2ff;
    border-bottom:2px solid #3d8bfd;
}
QWidget#TablePager {
    background:transparent;
}
QLabel#TablePagerLabel {
    color:#9aa6b4;
    padding:0 8px;
}
QPushButton#TablePagerButton {
    background:#232a33;
    border:1px solid #2a313b;
    border-radius:6px;
    padding:2px 10px;
    min-width:22px;
    color:#e6eaf0;
}
QPushButton#TablePagerButton:hover {
    border-color:#3d8bfd;
    color:#a8c7ff;
}
QPushButton#TablePagerButton:disabled {
    color:#5b6673;
    border-color:#232a33;
}
